function! HighlightActiveWindow()
    if &number
        setlocal relativenumber
    endif
    " Do not add the cursorline, if it was explicitly disabled, e.g. from an
    " ftplugin via:
    "   let b:disable_active_window_highlight_cul = 1
    if !get(b:, 'disable_active_window_highlight_cul', 0)
        setlocal cursorline
    endif
    " Do not add the colorcolumn, if it was explicitly disabled, e.g. from an
    " ftplugin via:
    "   let b:disable_active_window_highlight_cc = 1
    if !get(b:, 'disable_active_window_highlight_cc', 0)
        setlocal colorcolumn=80
    endif
endfunction

function! CmdLine(str)
    exe "menu Foo.Bar :" . a:str
    emenu Foo.Bar
    unmenu Foo
endfunction

function! VisualSelection(direction, extra_filter) range
    let l:saved_reg = @"
    execute "normal! vgvy"

    let l:pattern = escape(@", '\\/.*$^~[]')
    let l:pattern = substitute(l:pattern, "\n$", "", "")

    if a:direction == 'b'
        execute "normal ?" . l:pattern . "^M"
    elseif a:direction == 'gv'
        call CmdLine("Ack \"" . l:pattern . "\" " )
    elseif a:direction == 'replace'
        call CmdLine("%s" . '/'. l:pattern . '/')
    elseif a:direction == 'f'
        execute "normal /" . l:pattern . "^M"
    endif

    let @/ = l:pattern
    let @" = l:saved_reg
endfunction

