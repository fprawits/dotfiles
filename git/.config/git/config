[alias]
	alias = config --get-regexp ^alias\\.
	br = branch
	ca = commit --amend --verbose
	c  = commit --verbose
	co = checkout
	ctags = !.git/hooks/ctags
	last = log -1 HEAD
	lol = log --oneline --decorate --graph
	lola = log --oneline --decorate=full --graph --all --pretty=format:'%C(auto)%h %d %s %C(dim white)(%an)%C(reset)'
	s  = status --short
	st = status
	sw = switch
	za = stash apply
	zp = stash pop
	z  = stash list
	zz = stash
[branch]
	sort = -committerdate
[commit]
	verbose = true
[core]
	editor = vim --nofork
	autocrlf = input
	pager = delta
[delta]
	navigate = true  # use n and N to move between diff sections
	side-by-side = true
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
	renames = true
	submodule = log
	guitool = meld
	tool = vimdiff
[difftool]
	prompt = false
[difftool "meld"]
	cmd = meld "$LOCAL" "$REMOTE"
[init]
	defaultBranch = main
	templatedir = ~/.git_template
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictstyle = zdiff3
	guitool = meld
	tool = vimdiff
[mergetool "meld"]
	useAutoMerge = auto
	cmd = meld "$LOCAL" "$MERGED" "$REMOTE" --output "$MERGED"
[mergetool "vimdiff"]
	hideresolved = true
	layout = "@LOCAL,REMOTE"
[push]
	default = simple
[tag]
	sort = version:refname
[url "git@git-service.ait.ac.at:"]
	insteadOf = https://git-service.ait.ac.at/
