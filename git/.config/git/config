[alias]
	alias = config --get-regexp ^alias\\.
	br = branch
	ca = commit --amend --verbose
	c  = commit --verbose
	co = checkout
	ctags = !.git/hooks/ctags
	last = log -1 HEAD
	lol = log --oneline --decorate --graph
	lola = log --oneline --decorate --graph --all
	s  = status --short
	st = status
	sw = switch
	za = stash apply
	zp = stash pop
	z  = stash list
	zz = stash
[core]
	editor = vim --nofork
	autocrlf = input
	pager = delta
[delta]
	navigate = true  # use n and N to move between diff sections
	side-by-side = true
[diff]
	algorithm = histogram
	tool = meld
	colorMoved = default
[difftool]
	prompt = false
[difftool "meld"]
	cmd = meld "$LOCAL" "$REMOTE"
[init]
	templatedir = ~/.git_template
[interactive]
	diffFilter = delta --color-only
[merge]
	tool = meld
[mergetool "meld"]
	cmd = meld "$LOCAL" "$MERGED" "$REMOTE" --output "$MERGED"
[push]
	default = simple
