[alias]
	br = branch
	c  = commit --vebose
	ca = commit --amend --verbose
	co = checkout
	s  = status --short
	st = status
	sw = switch
	z  = stash list
	za = stash apply
	zz = stash
	alias = config --get-regexp ^alias\\.
	ctags = !.git/hooks/ctags
	last = log -1 HEAD
	lol = log --oneline --decorate --graph
[core]
	editor = vim
	autocrlf = input
	pager = delta
[delta]
	navigate = true  # use n and N to move between diff sections
	side-by-side = true
[diff]
	algorithm = histogram
	tool = meld
	colorMoved = default
[difftool]
	prompt = false
[difftool "meld"]
	cmd = meld "$LOCAL" "$REMOTE"
[init]
	templatedir = ~/.git_template
[interactive]
	diffFilter = delta --color-only
[merge]
	tool = meld
[mergetool "meld"]
	cmd = meld "$LOCAL" "$MERGED" "$REMOTE" --output "$MERGED"
[push]
	default = simple
